PORT=4000
# Use a long random string in production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
# Defaults to data/reelboard.db
# DATABASE_PATH=./data/reelboard.db
CORS_ORIGIN=*

# For `npm run enrich-omdb` — get a key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Social sign-in (optional — the buttons explain what's missing until set).
# Google: OAuth client ids from Google Cloud, comma-separated (at least the web client id).
GOOGLE_CLIENT_IDS=
# Apple: the app's bundle id. Add host.exp.Exponent to test in Expo Go.
APPLE_CLIENT_IDS=com.yazanwidyan.reelboard
