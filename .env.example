PORT=4000
# Use a long random string in production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
# Defaults to data/reelboard.db
# DATABASE_PATH=./data/reelboard.db
CORS_ORIGIN=*

# TMDB (themoviedb.org → Settings → API): every movie comes from it — search,
# movie pages, browsing, people, and `npm run build-pool`. The "API Read Access
# Token" (preferred) or the "API Key"; one is enough. Stays on the server.
TMDB_READ_TOKEN=
# TMDB_API_KEY=

# The admin site (../Reelboard-admin, at /admin): the accounts allowed in, by
# email, comma-separated.
ADMIN_EMAILS=
# Where its built files are (defaults to ../Reelboard-admin/dist).
# ADMIN_DIST=

# Social sign-in (optional — the buttons explain what's missing until set).
# Google: OAuth client ids from Google Cloud, comma-separated (at least the web client id).
GOOGLE_CLIENT_IDS=
# Apple: the app's bundle id. Add host.exp.Exponent to test in Expo Go.
APPLE_CLIENT_IDS=com.yazanwidyan.reelboard
