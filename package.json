{
  "name": "reelboard-backend",
  "version": "1.0.0",
  "description": "REST API for the ReelBoard app — accounts, library, boards, challenges, taste and friends.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "enrich-omdb": "node --env-file-if-exists=.env scripts/enrich-omdb.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  }
}
